{
  "schema_version": "1",
  "flavor": "claude",
  "multiagent_root_env": "MULTIAGENT_ROOT",
  "workers": {
    "claude-main": {
      "model": "host-default",
      "call_type": "native",
      "native": {
        "subagent_type": "claude-main",
        "prompt_source": "brief",
        "model_alias": "opus"
      },
      "approval_class": "worker",
      "result_capture": "orchestrator"
    },
    "codex-critic": {
      "model": "codex-default",
      "call_type": "mcp",
      "mcp": {
        "tool": "mcp__codex__codex",
        "sandbox": "read-only",
        "prompt_source": "brief"
      },
      "approval_class": "worker",
      "result_capture": "orchestrator",
      "fallback_note": "MCP 연결 실패 시 Orchestrator가 `codex exec --sandbox read-only -`(stdin으로 brief)로 직접 호출. 디스패처 비경유."
    },
    "ollama": {
      "model": "ollama-default",
      "call_type": "api",
      "api": {
        "ref": "adapters/ollama_api.sh",
        "brief_pass": "arg1"
      },
      "cwd_policy": "isolated_tmp",
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 300
    },
    "gemini": {
      "model": "gemini-3.1-pro-high",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "agy",
        "args_template": [
          "--prompt",
          "@brief_content"
        ]
      },
      "cwd_policy": "isolated_tmp",
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 300,
      "fallbacks": [],
      "fallback_note": "api 폴백 슬롯(adapters/gemini_api.sh)은 미구현(무조건 exit 4)이라 비활성 — 등록 시 거짓 안전신호. REST 구현 후 재등록."
    }
  }
}
